<!doctype html>
<html><head><meta charset="utf-8"><title>Aldidle stats</title>
<link rel="stylesheet" href="/assets/stats.css">
</head>
<body>
  <h1>Aldidle stats</h1>
  <div class="sub">Visits are deduped per browser per day. Finishes count won + lost games.</div>
  <div class="grid">
    <div class="kpi"><div class="label">Visits</div><div class="value"><%= stats.visits %></div></div>
    <div class="kpi"><div class="label">Guesses</div><div class="value"><%= stats.guesses %></div></div>
    <div class="kpi"><div class="label">Finishes</div><div class="value"><%= stats.finishes %></div></div>
    <div class="kpi"><div class="label">Win rate</div><div class="value"><%= winRate %></div></div>
    <div class="kpi"><div class="label">Avg attempts (wins)</div><div class="value"><%= avgWinAttempts %></div></div>
  </div>
  <h2>Last 30 days</h2>
  <table>
    <thead><tr><th>Day</th><th>Visits</th><th>Guesses</th><th>Finishes</th><th>Wins</th><th>Win %</th><th>Avg att.</th></tr></thead>
    <tbody>
      <% if (dayRows.length === 0) { %>
        <tr><td colspan="7" class="empty">No data yet</td></tr>
      <% } else { %>
        <% dayRows.forEach(function(r) { %>
          <tr>
            <td><%= r.day || '(unknown)' %></td>
            <td><%= r.visits %></td>
            <td><%= r.guesses %></td>
            <td><%= r.finishes %></td>
            <td><%= r.wins %></td>
            <td><%= r.winRate %></td>
            <td><%= r.avgAttempts %></td>
          </tr>
        <% }) %>
      <% } %>
    </tbody>
  </table>
  <div class="two">
    <div>
      <h2>By market</h2>
      <table>
        <thead><tr><th>Market</th><th>Events</th></tr></thead>
        <tbody>
          <% if (marketRows.length === 0) { %>
            <tr><td colspan="2" class="empty">—</td></tr>
          <% } else { %>
            <% marketRows.forEach(function(r) { %>
              <tr><td><%= r[0] %></td><td><%= r[1] %></td></tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
    <div>
      <h2>By language</h2>
      <table>
        <thead><tr><th>Lang</th><th>Events</th></tr></thead>
        <tbody>
          <% if (langRows.length === 0) { %>
            <tr><td colspan="2" class="empty">—</td></tr>
          <% } else { %>
            <% langRows.forEach(function(r) { %>
              <tr><td><%= r[0] %></td><td><%= r[1] %></td></tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</body></html>
