  <div class="hero">
    <div class="wordmark">WINK<span class="print leopard">L</span><span class="print zebra">E</span></div>
    <div class="tagline">Raad de prijs van het dagelijkse product</div>
    <div class="subtag">Guess the price of today's product</div>
  </div>

  <div class="stores-wrap">
    <div class="pick">Kies je winkel · Choose your store</div>
    <div class="stores" id="stores"></div>
  </div>

  <footer>Winkle is een fan-project &nbsp;·&nbsp; niet verbonden met de getoonde winkels</footer>

  <script src="/assets/stores.js"></script>
  <script>
    const grid = document.getElementById('stores');
    grid.innerHTML = Object.values(STORES).map(s => `
      <a class="store-card" href="/${s.slug}" aria-label="${s.name}">
        <div class="store-logo" style="background:${s.color}">
          <span class="mark">${s.logo}</span>
          <span class="bar" style="background:${s.accent}"></span>
        </div>
        <div class="store-name">${s.name}<div class="store-cta">Spelen →</div></div>
      </a>
    `).join('');
  </script>
